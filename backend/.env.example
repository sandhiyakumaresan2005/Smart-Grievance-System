# Server Configuration
PORT=5001

# Database Connection (Local or MongoDB Atlas)
# Local: mongodb://127.0.0.1:27017/scgrs
# Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/scgrs?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/scgrs

# JWT Authentication Secret
JWT_SECRET=scgrs_super_secret_jwt_key_2026

# Microservice URL (Flask Python AI Service)
AI_SERVICE_URL=http://127.0.0.1:5000

# Automated Email Notifications (Nodemailer / SMTP)
# Leave blank to use built-in console / Ethereal test mailer
EMAIL_SERVICE=gmail
EMAIL_USER=your_campus_notifications@gmail.com
EMAIL_PASS=your_gmail_app_password
EMAIL_FROM="Smart Campus Grievance System" <noreply@scgrs.campus.edu>
